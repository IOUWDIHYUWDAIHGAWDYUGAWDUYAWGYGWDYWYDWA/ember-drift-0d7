# ---------------------------------------------------------------------------
# Lumo Panel — ortam değişkenleri
# Kopyala: cp .env.example .env
# ---------------------------------------------------------------------------

# ZORUNLU. Durumun tamamı (kullanıcılar, sunucular, bot token'ları) bu anahtarla
# AES-256-GCM ile şifrelenir. 64 hex karakter üret:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Anahtarı kaybedersen veriyi kurtaramazsın. Depoya asla commit etme.
PANEL_MASTER_KEY=

# HTTP portu (varsayılan 8080) ve bağlanılacak arayüz.
PANEL_PORT=8080
PANEL_HOST=0.0.0.0

# Panel durumunun ve yedeklerin yazıldığı dizin.
PANEL_DATA_DIR=./data

# Sunucu (bot) dosyalarının kök dizini. Docker'da panel konteyneri host'un Docker
# soketini kullandığı için bu yol host'ta ve konteynerde AYNI olmalıdır
# (örn. /opt/lumo-panel/servers).
PANEL_SERVERS_DIR=./data/servers

# Süpervizör sürücüsü: docker (üretim, izole) | local (geliştirme, izolasyon zayıf)
PANEL_BOT_DRIVER=local

# Botlara ayrılacak port aralığı (Pterodactyl'deki allocation havuzu).
PANEL_PORT_RANGE=30000-30099
# Tahsis edilen portu dinleyecek arayüz. Varsayılan 127.0.0.1: sadece aynı makineden
# erişilebilir. Dışarıya açman gerekiyorsa bilinçli olarak değiştir.
PANEL_PORT_BIND=127.0.0.1

# Yeni sunucular için varsayılan limitler (Pterodactyl kaynak kutuları).
PANEL_DEFAULT_MEMORY_MB=512
PANEL_DEFAULT_CPU=1.0
PANEL_DEFAULT_DISK_MB=2048
PANEL_DEFAULT_PIDS=256

# Başlangıç tespiti: egg'in "başladı" deseni bu süre içinde görülmezse süreç
# yeniden başlatılır ve çökme sayılır (Pterodactyl'in startup timeout'u).
PANEL_STARTUP_TIMEOUT_MS=90000

# Aynı botun dakikalar içinde kaç çökmesinden sonra otomatik yeniden başlatma
# duracak ve sunucu "crashed" durumunda askıya alınacak.
PANEL_CRASH_LIMIT=5
PANEL_CRASH_WINDOW_MS=600000

# Ters proxy (Caddy/Nginx) arkasındaysan X-Forwarded-For'a güven.
PANEL_TRUST_PROXY=0

# Geliştirme kolaylığı: 1 ise panel çerezleri Secure işaretlenmez (yalnızca http).
# HTTPS arkasında bunu 1 YAPMA.
PANEL_INSECURE_COOKIES=0

# Denetim kaydında tutulacak en fazla kayıt sayısı.
PANEL_AUDIT_LIMIT=2000

# Oturum ömrü (ms) ve giriş hız sınırı.
PANEL_SESSION_TTL_MS=43200000
PANEL_LOGIN_WINDOW_MS=600000
PANEL_LOGIN_MAX_ATTEMPTS=10

# 1 yaparsan her HTTP isteği loglanır (sorun ayıklamak için).
PANEL_ACCESS_LOG=0
