# ---------------------------------------------------------------------------
# Lumo Panel — örnek ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldur. `.env` git'e GİRMEZ.
# ---------------------------------------------------------------------------

# 32 byte (64 hex karakter) ana anahtar. Üretmek için:  npm run genkey
# Bu anahtar olmadan panel verisi (kullanıcılar, bot ayarları, bot token'ları)
# çözülemez. Yedeğini güvenli bir yerde tut; kaybedersen veri gider.
PANEL_MASTER_KEY=

# Arayüzün dinleyeceği port ve adres
PORT=8080
HOST=0.0.0.0

# Veri dizinleri.
# NOT: docker-compose.yml bu değerleri LUMO_DIR'e göre ezer; buradaki
# göreli yollar yalnızca doğrudan (Docker'sız) çalıştırma içindir.
PANEL_DATA_DIR=./data
PANEL_BOTS_DIR=./bots

# Bot süreç sürücüsü:
#   local  → aynı makinede alt süreç olarak çalışır (izolasyon zayıf)
#   docker → her bot kendi izole konteynerinde çalışır (ÜRETİM İÇİN ÖNERİLEN)
PANEL_BOT_DRIVER=local

# Oturum süresi (saat)
PANEL_SESSION_TTL_HOURS=12

# Ters proxy (Caddy/nginx/Cloudflare) arkasındaysa 1 yap; Secure cookie için şart
PANEL_TRUST_PROXY=0

# --- Aşağıdakiler yalnızca docker compose tarafından okunur -----------------

# Panelin kurulu olduğu MUTLAK dizin. Bot dizini konteynere aynı mutlak yolla
# mount edilmek zorundadır, aksi halde `docker run -v` host'ta geçersiz yol alır.
LUMO_DIR=/opt/lumo-panel

# Panelin hangi arayüze bağlanacağı. Varsayılan olarak yalnızca localhost;
# ters proxy kullanmıyorsan (HTTPS'siz, önerilmez) 0.0.0.0 yap.
PANEL_BIND=127.0.0.1
