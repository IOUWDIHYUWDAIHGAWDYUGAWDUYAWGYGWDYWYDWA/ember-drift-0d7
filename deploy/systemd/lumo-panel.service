# Docker'sız (bare-metal) kurulum için systemd birimi.
#
#   sudo cp deploy/systemd/lumo-panel.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now lumo-panel
#
# Kurulum varsayımları:
#   • proje /opt/lumo-panel içinde
#   • panel kullanıcısı "lumo" (sudo useradd -r -m -d /opt/lumo-panel lumo)
#   • .env /opt/lumo-panel/.env (chmod 600, sahibi lumo)

[Unit]
Description=Lumo Panel — Discord bot kontrol paneli
Documentation=https://github.com/example/lumo-panel
After=network-online.target
Wants=network-online.target
# Docker sürücüsü kullanılacaksa:
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=lumo
Group=lumo
WorkingDirectory=/opt/lumo-panel
EnvironmentFile=/opt/lumo-panel/.env
ExecStart=/usr/bin/node server/index.js

# Panel ölürse veya makine yeniden başlarsa 3 saniyede geri gelir.
Restart=always
RestartSec=3
TimeoutStopSec=30

# --- Sertleştirme -----------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
CapabilityBoundingSet=
AmbientCapabilities=
# Yalnızca veri ve bot dizinlerine yazabilir.
ReadWritePaths=/opt/lumo-panel/data /opt/lumo-panel/servers
# Docker soketini kullanabilmek için (root grubu yerine docker grubu):
SupplementaryGroups=docker

[Install]
WantedBy=multi-user.target
